#!/usr/local/env groovy

/**
 *
 * Jenkinsfile for building rapids-plugin databricks301 and databricks311 shim jars
 *
 */

@Library(['shared-libs', 'blossom-lib']) _

def idleTime = 180 // Timeout for both Jenkins the job and cluster idle time
def urmUrl = "${common.urmURL}/artifactory/sw-spark-maven"

// Pass the commit HEAD to spark-rapids nightly pipeline to make sure
// databricks shim and spark-rapids build are using the same commit IDs.
class Global {
    static String commitId = ''
}

//constant parameters for aws and azure databrics cluster
class Constants {
    static final ID_HOST = 0, ID_TOKEN = 1, ID_DRIVER = 2, ID_WORKER = 3
    static final PARAM_MAP = [
            'aws'  : [
                    'https://dbc-9ff9942e-a9c4.cloud.databricks.com',
                    'SPARK_AWS_DATABRICKS_TOKEN',
                    'g4dn.2xlarge',
                    'g4dn.2xlarge'
            ],
            'azure': [
                    'https://adb-6905323869956636.16.azuredatabricks.net',
                    'SPARK_AZURE_DATABRICKS_TOKEN',
                    'Standard_NC6s_v3',
                    'Standard_NC6s_v3'
            ]
    ]
    static final ID_RUNTIME = 0, ID_SPARK = 1, ID_INITSCRIPTS = 2, ID_PROFILES = 3, ID_INSTALL = 4
    static final RUNTIME_MAP = [
            '7.3': [
                    '7.3.x-gpu-ml-scala2.12',
                    '3.0.1',
                    'init_cudf_udf.sh,init_cuda11_runtime.sh',
                    'databricks301,!snapshot-shims',
                    '3.0.1'
            ],
            '8.2': [
                    '8.2.x-gpu-ml-scala2.12',
                    '3.1.1',
                    'init_cudf_udf.sh',
                    'databricks311,!snapshot-shims',
                    '3.1.1'
            ]
    ]
}

import static Constants.*

// params.DATABRICKS_TYPE : 'aws' or 'azure', parameter defined in the Jenkins configurations webUI
String getDbType() {
    return params.DATABRICKS_TYPE ? params.DATABRICKS_TYPE : 'aws'
}
// foo.sh,bar.sh --> /dbfs/path/foo.sh,/dbfs/path/bar.sh
String getInitScripts(String rootDir, String files) {
    return rootDir + '/' + files.replace(',', ',' + rootDir + '/')
}

def buildYAML = pod.getCPUYAML("${common.ARTIFACTORY_NAME}/sw-spark-docker/spark:rapids-databricks")

pipeline {
    agent {
        kubernetes {
            label "nightly-init-${BUILD_TAG}"
            cloud 'sc-ipp-blossom-prod'
        }
    }

    options {
        ansiColor('xterm')
        // IDLE_TIMEOUT config as well
        timeout(time: idleTime, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        string(name: 'REF', defaultValue: 'branch-21.10',
                description: 'Commit to build')
        string(name: 'REPO_URL', defaultValue: 'https://github.com/NVIDIA/spark-rapids.git',
                description: 'Github Repo URL')
        string(name: 'GPU_TYPE', defaultValue: 'Tesla_T4',
                description: 'https://blossom.nvidia.com/sw-gpu-spark-jenkins/lockable-resources/')
        string(name: 'NUM_WORKERS', defaultValue: '0',
                description: 'Number of databricks workers')
        choice(name: 'TRIGGER_DOWNSTREAM', choices: ['true', 'false'],
                description: 'if trigger downstream jobs')
    }

    environment {
        IDLE_TIMEOUT = "${idleTime}"
        MVN_URM_MIRROR = '-s jenkins/settings.xml -P mirror-apache-to-urm'
        LIBCUDF_KERNEL_CACHE_PATH = '/tmp/.cudf'
        URM_CREDS = credentials("urm_creds")
        DB_TYPE = getDbType()
        DATABRICKS_HOST = "${PARAM_MAP["$DB_TYPE"][ID_HOST]}"
        DATABRICKS_TOKEN = credentials("${PARAM_MAP["$DB_TYPE"][ID_TOKEN]}")
        DATABRICKS_PUBKEY = credentials("SPARK_DATABRICKS_PUBKEY")
        DATABRICKS_DRIVER = "${PARAM_MAP["$DB_TYPE"][ID_DRIVER]}"
        DATABRICKS_WORKER = "${PARAM_MAP["$DB_TYPE"][ID_WORKER]}"
        URM_URL = "${urmUrl}"
        INIT_SCRIPTS_DIR = "dbfs:/databricks/init_scripts/${REF}"
        CUSTOM_WORKSPACE = "/home/jenkins/agent/workspace/${JOB_NAME}"
        PVC = credentials("pvc")
    }

    stages {

                stage('Spark311 DB8.2') {
                    agent {
                        kubernetes {
                            label "nightly-databricks311-${BUILD_NUMBER}"
                            cloud 'sc-ipp-blossom-prod'
                            yaml "$buildYAML"
                            workspaceVolume persistentVolumeClaimWorkspaceVolume(claimName: "${PVC}", readOnly: false)
                            customWorkspace "${CUSTOM_WORKSPACE}-311-${BUILD_NUMBER}"
                        }
                    }
                    environment {
                        DB_RUNTIME = '8.2'
                        DATABRICKS_RUNTIME = "${RUNTIME_MAP["$DB_RUNTIME"][ID_RUNTIME]}"
                        BASE_SPARK_VERSION = "${RUNTIME_MAP["$DB_RUNTIME"][ID_SPARK]}"
                        BASE_SPARK_VERSION_TO_INSTALL_DATABRICKS_JARS = "${RUNTIME_MAP["$DB_RUNTIME"][ID_INSTALL]}"
                        BUILD_PROFILES = "${RUNTIME_MAP["$DB_RUNTIME"][ID_PROFILES]}"
                        INIT_SCRIPTS = getInitScripts("$INIT_SCRIPTS_DIR", "${RUNTIME_MAP["$DB_RUNTIME"][ID_INITSCRIPTS]}")
                    }
                    steps {
                        script {
                            databricksBuild()
                        }
                    }
                } // end of Spark311 DB8.2

        stage("handle if errors") {
            steps {
                script {
                    if (env.FAILURE_INFO?.trim()) {
                        print "ERRORS:\n${env.FAILURE_INFO}"
                        throw env.FAILURE_INFO
                    }
                }
            }
        }

    } // end of stages

    post {
        always {
            script {
                if (!params.MUTE_SLACK) common.slack(this, '#swrapids-spark-cicd', '', '1')
            }
        }
    }
} // end of pipeline

void databricksBuild() {
    def CLUSTER_ID = ''
    def SPARK_MAJOR = BASE_SPARK_VERSION_TO_INSTALL_DATABRICKS_JARS.replace('.', '')
    try {

        stage("Deploy $SPARK_MAJOR shim jar") {
            script {
                try {
                    container('cpu') {
                        sh "./jenkins/databricks/deploy_both.sh"
                    }
                } catch (e) {
                    env.FAILURE_INFO += "\n" + e.toString() + " - deploy $DB_RUNTIME"
                    // test error would not block downstream trigger
                }
            }
        }

    } finally {
        if (CLUSTER_ID) {
            container('cpu') {
                retry(3) {
                    sh "python3 ./jenkins/databricks/shutdown.py -s $DATABRICKS_HOST -t $DATABRICKS_TOKEN -c $CLUSTER_ID -d"
                    sleep 10
                }
            }
        }
    }
}
